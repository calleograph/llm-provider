# Защита при развёртывании с document root В КОРНЕ проекта (для хостингов без
# возможности указать document root на подкаталог public/). См. README,
# раздел «Развёртывание с document root в корне проекта».
#
# Работает только под Apache/LiteSpeed с включённым AllowOverride (обычная
# ситуация на shared hosting). Для nginx .htaccess НЕ действует — там нужен
# отдельный блок location в конфиге сервера, см. config/nginx.example.conf
# и README. Если у вас nginx, ЭТОТ ФАЙЛ САМ ПО СЕБЕ ВАС НЕ ЗАЩИЩАЕТ.

# Полный запрет веб-доступа к каталогам с исходным кодом, шаблонами, данными
# и секретами — ни при каких обстоятельствах не должны быть скачиваемы.
RewriteEngine On
RewriteCond %{REQUEST_URI} ^/(src|var|templates|tests|bin|config|vendor|\.git)(/|$) [NC]
RewriteRule ^ - [F,L]

<IfModule mod_authz_core.c>
    <FilesMatch ".">
        <If "-d %{REQUEST_FILENAME}">
            Require all denied
        </If>
    </FilesMatch>
</IfModule>

# Запрет отдачи файлов конфигурации/данных/секретов по расширению — двойная
# защита на случай, если правило по каталогам выше не сработает (например,
# после переезда каталогов или изменения структуры).
<FilesMatch "\.(sqlite|sqlite3|db|key|pem|crt|cer|der|log|md|xml|lock|dist|c|o)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|phpunit\.xml|Makefile|\.gitignore|\.env.*)$">
    Require all denied
</FilesMatch>

# Никаких directory listing.
Options -Indexes

# Разрешённые точки входа в корне — только эти PHP-файлы обслуживают запросы
# напрямую (сами они лишь тонкие шлюзы в public/, см. каждый файл).
# index.php — вход в чат (доменная авторизация); api.php — его JSON API.
<FilesMatch "^(index|healthz|api)\.php$">
    Require all granted
</FilesMatch>
