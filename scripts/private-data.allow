anthropic.com
polza.ai
openrouter.ai
deepseek.com
nginx.org
php.net
phpunit.de
getcomposer.org
debian.org
ubuntu.com
alpinelinux.org
w3.org
openxmlformats.org
oasis-open.org
purl.org
microsoft.com
schemas.microsoft.com
fonts.googleapis.com
gstatic.com
mozilla.org
