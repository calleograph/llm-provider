ip:127\.\d+\.\d+\.\d+
ip:0\.0\.0\.0
ip:192\.0\.2\.\d+
ip:198\.51\.100\.\d+
ip:203\.0\.113\.\d+
ip:10\.0\.0\.\d+
ip:172\.16\.0\.\d+
ip:192\.168\.0\.\d+
ip:169\.254\.\d+\.\d+
ip:1\.2\.3\.4
ip:255\.255\.255\.\d+
proglib.io
sil.org
other.local
anon.local
python.org
ip:1\.1\.1\.1
ip:224\.0\.0\.0
ip:240\.0\.0\.0
