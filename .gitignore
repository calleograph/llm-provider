# Секреты и рабочие данные — никогда не в репозитории.
/var/data/
/var/*
!/var/.htaccess
/var/certs/
/var/logs/
/var/sessions/
/var/tmp/

# Тестовый кэш и случайные экспорты (например, «Скачать .txt» из «Журнал»).
/log_all_*.txt

# Ключи, сертификаты и копии локальных правок (update.sh кладёт их в backups/) — случайный `git add -A` их не подхватит.
/backups/
*.key
*.pem
*.p12
*.pfx

# IDE / ОС.
.vscode/
.DS_Store
Thumbs.db

# Docker/установка: секреты и данные хоста вне репозитория.
.env
.env.*
!.env.example
/data/
/models/
__pycache__/
*.pyc
.pytest_cache/
.backup.key
.update.lock
*.bak.gpg
.venv/

# Рабочие заметки разработчика: остаются локально, в публичный репозиторий не входят.
/HISTORY.md
/PROJECT.md
/PORTING_PLAN.md
/PYTHON_PORT_PLAN.md
/tests/PARITY.md
/tests/parity/
