# Конфигурация экземпляра LLM-провайдера. Создаётся установщиком (install.sh) как .env с правами 600; в git не хранится.
# Секреты генерирует установщик; повторный запуск их не меняет.

# --- экземпляр
COMPOSE_PROJECT_NAME=llmprov
# standalone | shared-host
INSTALL_PROFILE=shared-host
# каталог данных: БД, настройки, журналы, модели ASR, резервные копии (вне каталога кода)
DATA_ROOT=/srv/llm-provider-data
# адрес публикации порта nginx приложения; внешний доступ — через системный nginx/прокси
APP_BIND=127.0.0.1
APP_PORT=18480
# https://chat.example.com — для проверки Origin диктовки и ссылок в письмах
APP_PUBLIC_URL=
# публикация: port (порт для прокси) или nginx (свой сайт) — заполняет install.sh, повторный запуск берёт отсюда
PUBLISH=
# откуда nginx приложения принимает X-Forwarded-For (сеть Docker)
TRUSTED_PROXY_CIDR=172.16.0.0/12
# voice — диктовка (ASR + Redis); пусто — без голосового ввода
COMPOSE_PROFILES=voice
ASR_ENABLED=1
IMAGE_TAG=local

# --- секреты (заполняет install.sh)
APP_MASTER_KEY=
INTERNAL_API_TOKEN=
DICTATION_SECRET=
REDIS_PASSWORD=

# --- ресурсы
# процессы Uvicorn приложения и лимит памяти контейнера app
APP_WORKERS=4
APP_MEM_LIMIT=2g
ANON_MEM_LIMIT=1536m
ANON_CONCURRENCY=4
ASR_MEM_LIMIT=4g
ASR_CPU_THREADS=0
ASR_INTEROP_THREADS=0
ASR_MAX_CONCURRENT_INFERENCE=1

# --- распознавание речи (GigaAM v3, локально)
ASR_MODEL_NAME=v3_e2e_rnnt
ASR_MODEL_ID=gigaam-v3-e2e-rnnt-full
ASR_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
GIGAAM_GIT_COMMIT=7447938d791c4f3e643386ee22c33777004293a5
# Свой источник весов (внутреннее зеркало) — по желанию; сначала всегда пробуется зеркало проекта на GitHub, затем этот адрес, затем CDN Сбера.
GIGAAM_MODEL_BASE_URL=
# SHA-256 весов — по желанию; для модели по умолчанию (v3_e2e_rnnt) проверенные значения встроены в scripts/models.sh.
GIGAAM_CKPT_SHA256=
GIGAAM_TOKENIZER_SHA256=

# --- резервные копии
# пусто — ${DATA_ROOT}/backups
BACKUP_DIR=
BACKUP_KEEP=14
