# Шаблон nginx (envsubst при старте контейнера). Внешний TLS — на системном nginx/reverse proxy (shared-host) или на этом же сервере (standalone).
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
# Доверенный адрес внешнего прокси — для X-Forwarded-For (настраивается в .env, по умолчанию сеть Docker).
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

server {
    listen 8080;
    server_name _;
    root /srv/app/public;
    index index.php;
    server_tokens off;
    client_max_body_size 130m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    location = /nginx-health { access_log off; return 200 "ok\n"; }

    # Голосовая диктовка: WebSocket в ASR (PHP-FPM не держит соединения). Вход — одноразовый билет, выданный api.php.
    location = /ws/dictation {
        set $asr_upstream http://asr:8090;
        resolver 127.0.0.11 valid=10s ipv6=off;
        proxy_pass $asr_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Origin $http_origin;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }

    location /assets/ { expires 7d; access_log off; try_files $uri =404; }

    location = /healthz.php { allow 127.0.0.1; deny all; include /etc/nginx/fastcgi_app.conf; }

    location / { try_files $uri $uri/ /index.php?$query_string; }
    location /admin/ { try_files $uri $uri/ /admin/index.php?$query_string; }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_read_timeout 660s;
        include /etc/nginx/fastcgi_app.conf;
    }

    location ~ /\. { deny all; }
}
