# Пример конфигурации logrotate для var/logs/php_errors.log (технический
# лог PHP fatal errors/warnings, отдельный от журналов в SQLite, которые
# ротируются автоматически самим приложением — см. src/Diagnostics/LogRotationService.php).
#
# Установка: скопируйте этот файл в /etc/logrotate.d/ai-chat
# (замените путь /var/www/ai-chat на реальный путь установки)
# и подставьте реального пользователя/группу веб-сервера.

/var/www/ai-chat/var/logs/php_errors.log {
    size 50M
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su www-data www-data
}
