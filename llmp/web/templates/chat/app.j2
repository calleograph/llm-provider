{% macro icon(path) %}<svg viewBox="0 0 24 24" aria-hidden="true">{{ path|safe }}</svg>{% endmacro %}
{% set icon_panel = icon('<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M9 4v16"/>') %}
<!doctype html>
<html lang="ru" data-site-theme="{{ site_theme() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Корпоративный AI-чат</title>
<link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
<link rel="icon" type="image/png" href="assets/favicon.png">
<link rel="stylesheet" href="{{ asset('assets/css/app.css') }}">
<script src="{{ asset('assets/js/theme.js') }}"></script>
</head>
<body class="chat-body">
<div class="gpt-shell" id="chatApp"
     data-csrf="{{ csrf_token }}"
     data-max-upload-mb="{{ max_upload_mb }}"
     data-extensions="{{ extensions|join(',') }}"
     data-ready="{{ '1' if anonymization_ready and providers else '0' }}"
     data-can-skip-anonymization="{{ '1' if can_skip_anonymization else '0' }}"{% if insecure %} data-insecure="1"{% endif %}>

  <aside class="gpt-sidebar" id="gptSidebar" aria-label="Боковая панель">
    <div class="gpt-side-top">
      <span class="gpt-brand">{% include "brand_mark.j2" %}AI-чат</span>
      <button type="button" class="gpt-icon-btn" id="sidebarClose" title="Закрыть боковую панель" aria-label="Закрыть боковую панель">{{ icon_panel }}</button>
    </div>

    <button type="button" class="gpt-side-item gpt-side-strong" id="chatNew">
      {{ icon('<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>') }}
      Новый чат
    </button>
    <label class="gpt-search">
      {{ icon('<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>') }}
      <input type="search" id="chatSearch" placeholder="Поиск по чатам" autocomplete="off" aria-label="Поиск по чатам">
    </label>

    <div class="gpt-side-scroll">
      <section id="searchSection" hidden>
        <p class="gpt-side-title">Результаты поиска</p>
        <nav id="searchResults"></nav>
      </section>
      <section id="pinnedSection" hidden>
        <p class="gpt-side-title">Закреплённые</p>
        <nav id="pinnedList"></nav>
      </section>
      <section id="chatsSection">
        <nav id="chatList"><p class="gpt-side-empty">Загрузка…</p></nav>
      </section>
    </div>

    <div class="gpt-projects">
      <div class="gpt-side-title-row">
        <p class="gpt-side-title">Проекты</p>
        <button type="button" class="gpt-icon-btn gpt-icon-small" id="projectNew" title="Новый проект" aria-label="Новый проект">{{ icon('<path d="M12 5v14M5 12h14"/>') }}</button>
      </div>
      <nav id="projectList"></nav>
    </div>

    <div class="gpt-user">
      <div class="gpt-usage" id="usageBox" hidden>
        <div class="gpt-usage-text" id="usageText"></div>
        <div class="gpt-usage-bar"><span id="usageBar"></span></div>
      </div>
      <button type="button" class="gpt-usage gpt-usage-storage" id="storageBox" hidden>
        <div class="gpt-usage-text" id="storageText"></div>
        <div class="gpt-usage-bar"><span id="storageBar"></span></div>
      </button>
      <div class="gpt-user-row">
        <span class="gpt-avatar" aria-hidden="true">{{ user.username[:1]|upper }}</span>
        <span class="gpt-user-name" title="{{ user.group_names|join(', ') }}">{{ user.log_name() }}</span>
      </div>
      <div class="gpt-user-actions">
        {% include "theme_toggle.j2" %}
        <form method="post" action="index.php?action=logout">
          <input type="hidden" name="csrf" value="{{ csrf_token }}">
          <button type="submit" class="link-button gpt-logout">Выйти</button>
        </form>
      </div>
    </div>
  </aside>
  <div class="gpt-backdrop" id="sidebarBackdrop" hidden></div>

  <main class="gpt-main" id="gptMain">
    <header class="gpt-header">
      <button type="button" class="gpt-icon-btn" id="sidebarOpen" title="Открыть боковую панель" aria-label="Открыть боковую панель">{{ icon_panel }}</button>
{% macro model_label(m) %}{{ m.display_name }}{{ ' · ' ~ m.provider_name if many_providers else '' }}{% endmacro %}
{% if models|length > 1 %}
      <span class="gpt-model-wrap">
      <select class="gpt-model-select" id="chatModel" aria-label="Модель">
{% for m in models %}
        <option value="{{ m.provider_id }}:{{ m.id }}" data-window="{{ m.context_window }}"{{ ' selected' if m.provider_default and m.is_default else '' }}>{{ model_label(m) }}</option>
{% endfor %}
      </select>
      {{ icon('<path d="m6 9 6 6 6-6"/>') }}
      </span>
{% elif models|length == 1 %}
      <span class="gpt-model-single">{{ model_label(models[0]) }}</span>
      <input type="hidden" id="chatModel" value="{{ models[0].provider_id }}:{{ models[0].id }}">
{% endif %}
      <div class="gpt-crumbs">
        <button type="button" class="gpt-crumb-project" id="crumbProject" hidden></button>
        <span class="gpt-title" id="chatTitle"></span>
      </div>
      <button type="button" class="gpt-icon-btn" id="answerSettingsOpen" title="Настройки ответа" aria-label="Настройки ответа" aria-haspopup="dialog">
        {{ icon('<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>') }}
      </button>
    </header>

{% if not providers %}
    <div class="alert alert-warn gpt-banner">Вам не назначено ни одной нейросети. Обратитесь к администратору, чтобы получить доступ.</div>
{% elif not anonymization_ready %}
    <div class="alert alert-warn gpt-banner">Сервис обезличивания не настроен — отправка сообщений временно недоступна.</div>
{% endif %}

    <section class="gpt-project" id="projectView" hidden>
      <div class="gpt-project-head">
        <span class="gpt-project-icon" aria-hidden="true">{{ icon('<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/>') }}</span>
        <h2 id="projectName"></h2>
        <button type="button" class="btn btn-small" id="projectRename">Переименовать</button>
        <button type="button" class="btn btn-small btn-danger" id="projectDelete">Удалить проект</button>
        <button type="button" class="gpt-icon-btn gpt-panel-close" id="projectViewClose" title="Закрыть и вернуться в чат" aria-label="Закрыть">{{ icon('<path d="M18 6 6 18M6 6l12 12"/>') }}</button>
      </div>
      <div class="gpt-project-tabs" role="tablist">
        <button type="button" class="gpt-project-tab active" data-project-tab="chats" role="tab" aria-selected="true">Чаты <span class="gpt-panel-meta" id="projectChatsTabCount"></span></button>
        <button type="button" class="gpt-project-tab" data-project-tab="instructions" role="tab" aria-selected="false">Инструкции <span class="gpt-panel-meta" id="projectInstructionsTabCount"></span></button>
        <button type="button" class="gpt-project-tab" data-project-tab="sources" role="tab" aria-selected="false">Материалы <span class="gpt-panel-meta" id="projectSourcesTabCount"></span></button>
        <button type="button" class="gpt-project-tab" data-project-tab="memory" role="tab" aria-selected="false">Память</button>
        <button type="button" class="gpt-project-tab" data-project-tab="settings" role="tab" aria-selected="false">Настройки</button>
      </div>

      <div class="gpt-project-tabpanel" data-project-panel="chats">
        <nav id="projectChats" class="gpt-project-chats"></nav>
      </div>

      <div class="gpt-project-tabpanel" data-project-panel="instructions" hidden>
        <div class="gpt-panel">
          <p class="gpt-panel-title">Инструкции проекта</p>
          <p class="gpt-panel-hint">
            Как модели работать во всех чатах проекта: роль, задача, требования к ответу. Это постоянная часть
            каждого запроса — пишите коротко. Перед сохранением текст обезличивается.
          </p>
          <label class="field-label" for="projectDescription">О проекте — одной фразой</label>
          <textarea class="text-input gpt-textarea-short" id="projectDescription" rows="2" maxlength="1000" placeholder="Например: подготовка договора поставки для юридического отдела"></textarea>
          <label class="field-label gpt-field-gap" for="projectInstructions">Основная инструкция <span class="gpt-panel-meta" id="projectInstructionsMeta"></span></label>
          <textarea class="text-input" id="projectInstructions" rows="6" maxlength="8000" placeholder="Например: ссылайся на пункты договора, отвечай по-деловому, спорные места помечай"></textarea>
          <div class="gpt-panel-actions">
            <button type="button" class="btn btn-small btn-primary" id="projectInstructionsSave">Сохранить</button>
            <span class="gpt-panel-status" id="projectInstructionsStatus" role="status"></span>
          </div>
          <p class="gpt-panel-title">Дополнительные блоки <span class="gpt-panel-meta" id="instructionsMeta"></span></p>
          <p class="gpt-panel-hint">Необязательные отдельные правила — например «Термины компании». У каждого блока свой лимит длины.</p>
          <div id="instructionList" class="gpt-sources"></div>
          <div class="gpt-instruction-add" id="instructionAddForm" hidden>
            <input class="text-input" id="instructionTitle" maxlength="120" placeholder="Название блока (необязательно)">
            <textarea class="text-input" id="instructionText" rows="4" placeholder="Например: отвечай кратко, в деловом стиле"></textarea>
            <div class="gpt-panel-actions">
              <button type="button" class="btn btn-small btn-primary" id="instructionSave">Сохранить блок</button>
              <button type="button" class="btn btn-small" id="instructionCancel">Отмена</button>
              <span class="gpt-panel-status" id="instructionStatus"></span>
            </div>
          </div>
          <button type="button" class="btn btn-small" id="instructionAddToggle">+ Добавить блок инструкций</button>
        </div>
      </div>

      <div class="gpt-project-tabpanel" data-project-panel="sources" hidden>
        <div class="gpt-panel" id="sourcesPanel">
          <div class="gpt-dropzone" id="sourceDropzone"><span>Отпустите файлы, чтобы добавить в материалы</span></div>
          <p class="gpt-panel-title">Материалы <span class="gpt-panel-meta" id="sourcesMeta"></span></p>
          <p class="gpt-panel-hint">
            Документы и тексты, на которые модель опирается во всех чатах проекта. Помещаются в окно модели —
            передаются целиком; не помещаются — только фрагменты, подходящие к вопросу, без повторов.
            Хранятся только обезличенными. Файлы можно перетащить прямо сюда.
          </p>
          <div id="sourceList" class="gpt-sources"></div>
          <div class="gpt-source-add">
            <input class="text-input" id="sourceTitle" maxlength="120" placeholder="Название (необязательно)">
            <textarea class="text-input" id="sourceText" rows="3" placeholder="Вставьте текст или приложите файл"></textarea>
            <div class="gpt-panel-actions">
              <label class="btn btn-small gpt-file-btn">Файл<input type="file" id="sourceFile" class="gpt-file-input" accept="{{ accept }}"></label>
              <span class="gpt-panel-status" id="sourceFileName"></span>
              <button type="button" class="btn btn-small btn-primary" id="sourceAdd">Добавить материал</button>
            </div>
          </div>
        </div>
      </div>

      <div class="gpt-project-tabpanel" data-project-panel="memory" hidden>
        <div class="gpt-panel">
          <p class="gpt-panel-title">Память проекта <span class="gpt-panel-meta" id="projectMemoryMeta"></span></p>
          <p class="gpt-panel-hint">
            Резюме работы, ключевые факты и решения, открытые задачи — общее для всех чатов проекта. Модель
            обновляет память сама, когда длинный разговор сворачивается в сводку. Можно поправить или очистить;
            правка обезличивается.
          </p>
          <p class="alert alert-warn gpt-project-off" id="projectMemoryOff" hidden>Память выключена в настройках проекта: модель её не видит и не обновляет.</p>
          <textarea class="text-input" id="projectMemory" rows="8" maxlength="4000" placeholder="Пока пусто — появится после длинного разговора в чате проекта. Можно записать важные факты и самому."></textarea>
          <div class="gpt-panel-actions">
            <button type="button" class="btn btn-small btn-primary" id="projectMemorySave">Сохранить</button>
            <button type="button" class="btn btn-small btn-ghost" id="projectMemoryClear">Очистить</button>
            <span class="gpt-panel-status" id="projectMemoryStatus" role="status"></span>
          </div>
        </div>
      </div>

      <div class="gpt-project-tabpanel" data-project-panel="settings" hidden>
        <div class="gpt-panel">
          <p class="gpt-panel-title">Сколько контекста занимает проект</p>
          <p class="gpt-panel-hint" id="projectBudgetHint"></p>
          <dl class="gpt-tokens-list gpt-project-budget" id="projectBudget"></dl>
          <p class="gpt-panel-title">Настройки проекта</p>
          <div class="gpt-project-settings">
            <div>
              <label class="field-label" for="projectModel">Модель для новых чатов</label>
              <select class="text-input" id="projectModel"></select>
            </div>
            <div>
              <label class="field-label" for="projectStyle">Стиль ответа</label>
              <select class="text-input" id="projectStyle"></select>
            </div>
            <div>
              <label class="field-label" for="projectShare">Место под материалы</label>
              <select class="text-input" id="projectShare">
                <option value="20">Не меньше 20 %</option>
                <option value="40">Не меньше 40 %</option>
                <option value="60">Не меньше 60 %</option>
                <option value="80">Не меньше 80 %</option>
              </select>
            </div>
          </div>
          <p class="gpt-panel-hint">Место под материалы — доля окна, которая всегда остаётся материалам; остальное получает история чата. Больше доля — больше фрагментов документов, меньше прежних сообщений.</p>
          <label class="switch"><input type="checkbox" id="projectUseSources"><span class="track"></span> Передавать материалы модели</label>
          <label class="switch"><input type="checkbox" id="projectUseMemory"><span class="track"></span> Вести и передавать память проекта</label>
          <div class="gpt-panel-actions">
            <button type="button" class="btn btn-small btn-primary" id="projectSettingsSave">Сохранить настройки</button>
            <span class="gpt-panel-status" id="projectSettingsStatus" role="status"></span>
          </div>
        </div>
      </div>
    </section>

    <section class="gpt-project" id="dataManagerView" hidden>
      <div class="gpt-project-head">
        <span class="gpt-project-icon" aria-hidden="true">{{ icon('<path d="M3 7h18M6 7v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/>') }}</span>
        <h2>Управление данными</h2>
        <button type="button" class="gpt-icon-btn gpt-panel-close" id="dataManagerClose" title="Закрыть и вернуться в чат" aria-label="Закрыть">{{ icon('<path d="M18 6 6 18M6 6l12 12"/>') }}</button>
      </div>
      <div class="gpt-panel">
        <p class="gpt-panel-title">Хранилище <span class="gpt-panel-meta" id="dataStorageMeta"></span></p>
        <p class="gpt-panel-hint">
          Учитывается объём обезличенного текста ваших чатов и источников проектов. Исходные загруженные файлы
          на сервере не хранятся — они удаляются сразу после обработки.
        </p>
        <div class="gpt-usage-bar gpt-usage-bar-wide"><span id="dataStorageBar"></span></div>
      </div>
      <div class="gpt-panel">
        <div class="llm-toolbar">
          <p class="gpt-panel-title">Чаты <span class="gpt-panel-meta" id="dataChatsCount"></span></p>
          <div class="gpt-panel-actions">
            <button type="button" class="btn btn-small" id="dataSelectAll">Выбрать все</button>
            <button type="button" class="btn btn-small btn-danger" id="dataDeleteSelected" disabled>Удалить выбранные</button>
            <button type="button" class="btn btn-small btn-danger" id="dataDeleteAll">Удалить всю историю</button>
          </div>
        </div>
        <div id="dataChatsList" class="gpt-data-list"></div>
      </div>
    </section>

    <div class="gpt-messages-wrap">
      <div class="gpt-messages" id="chatMessages" aria-live="polite">
        <div class="gpt-empty" id="chatEmpty">
          <h2 id="emptyTitle">Чем помочь?</h2>
          <p class="muted">Текст и файлы ({{ formats }}, до {{ max_upload_mb }} МБ)
            перед отправкой во внешний сервис обезличиваются. В истории хранится только обезличенный текст.</p>
          <p class="gpt-empty-legend">Так выглядят данные, которые заменены до отправки: <span class="gpt-mask">[телефон 1]</span> <span class="gpt-mask">[почта 1]</span> <span class="gpt-mask">[адрес]</span></p>
        </div>
      </div>
      <nav class="gpt-jumpdots" id="jumpDots" aria-label="Быстрый переход к своим сообщениям" hidden></nav>
      <button type="button" class="gpt-scroll-bottom" id="scrollToBottom" title="К последнему сообщению" aria-label="К последнему сообщению" hidden>
        {{ icon('<path d="M12 5v14M5 12l7 7 7-7"/>') }}
      </button>
    </div>

    <div class="gpt-composer-wrap" id="composerWrap">
      <div class="gpt-dropzone" id="chatDropzone"><span>Отпустите файлы, чтобы приложить к сообщению</span></div>
      <form class="gpt-composer" id="chatForm" autocomplete="off">
        <div class="gpt-attachment-list" id="chatAttachmentList" hidden></div>
        <textarea class="gpt-input" id="chatInput" rows="1" placeholder="Спросите что-нибудь" aria-label="Сообщение"></textarea>
        <div class="gpt-dictation" id="dictationBar" data-state="idle" role="status" aria-live="polite" hidden>
          <span class="gpt-dictation-dot" aria-hidden="true"></span>
          <span class="gpt-dictation-text" id="dictationText"></span>
          <span class="gpt-dictation-time" id="dictationTime"></span>
          <button type="button" class="btn btn-small" id="dictationStop">Стоп</button>
          <button type="button" class="btn btn-small btn-ghost" id="dictationCancel">Отмена</button>
        </div>
        <div class="gpt-composer-row">
          <label class="gpt-icon-btn gpt-attach" title="Приложить файлы (до 5)">
            {{ icon('<path d="m21 12-8.5 8.5a5 5 0 0 1-7-7L14 5a3.3 3.3 0 0 1 4.7 4.7l-8.5 8.5a1.7 1.7 0 0 1-2.4-2.4L15.5 8"/>') }}
            <input type="file" id="chatFile" class="gpt-file-input" accept="{{ accept }}" multiple>
          </label>
          <span class="gpt-hint">Enter — отправить, Shift+Enter — новая строка</span>
{% if can_skip_anonymization %}
          <label class="gpt-skip-anon" id="skipAnonWrap" title="Сообщение и файлы уйдут в нейросеть напрямую, без обезличивания. Используйте только если уверены, что в них нет персональных или конфиденциальных данных.">
            <input type="checkbox" id="skipAnonToggle">
            <span class="gpt-skip-anon-mark">!</span>
            <span class="gpt-skip-anon-text">не обезличивать</span>
          </label>
{% endif %}
          <button type="button" class="gpt-icon-btn gpt-mic" id="chatMic" data-state="idle" title="Голосовой ввод" aria-label="Голосовой ввод: начать запись" aria-pressed="false" hidden>
            {{ icon('<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>') }}
          </button>
          <span class="gpt-mic-insecure" role="note" title="Браузер даёт доступ к микрофону только странице, открытой по HTTPS. Попросите администратора включить HTTPS.">
            {{ icon('<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3M3 3l18 18"/>') }}
            Голосовой ввод — только по HTTPS
          </span>
          <button class="gpt-send" type="submit" id="chatSend" title="Отправить" aria-label="Отправить">{{ icon('<path d="M12 19V5M5 12l7-7 7 7"/>') }}</button>
        </div>
      </form>
    </div>
    <div class="gpt-foot">
      <p class="gpt-footnote">Персональные и конфиденциальные данные заменяются метками до отправки во внешнюю нейросеть.</p>
      <span class="gpt-telemetry" id="telemetryNote" tabindex="0" role="note" title="Запросы к внешним нейросетям и расход токенов фиксируются для контроля по соглашению об использовании." aria-label="Ведётся телеметрия: запросы к внешним нейросетям и расход токенов фиксируются для контроля по соглашению об использовании.">Ведётся телеметрия</span>
    </div>
  </main>
</div>
<div class="gpt-menu" id="ctxMenu" role="menu" hidden></div>
<dialog class="gpt-dialog" id="answerSettings" aria-labelledby="answerSettingsTitle">
  <form method="dialog" class="gpt-dialog-body" id="answerSettingsForm">
    <h2 class="gpt-dialog-title" id="answerSettingsTitle">Настройки ответа</h2>
    <label class="field-label" for="prefStyle">Стиль ответа</label>
    <select class="text-input" id="prefStyle"></select>
    <label class="field-label" for="prefDialog">Инструкция для этого чата</label>
    <textarea class="text-input" id="prefDialog" rows="3" maxlength="4000" placeholder="Например: отвечай с примерами на Python"></textarea>
    <p class="gpt-panel-hint" id="prefDialogHint">Появится после первого сообщения в чате.</p>
    <label class="field-label" for="prefPersonal">Мои постоянные инструкции (для всех чатов)</label>
