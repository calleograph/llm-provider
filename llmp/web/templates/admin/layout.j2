<!doctype html>
<html lang="ru" data-site-theme="{{ site_theme() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ page_title }} — Администрирование</title>
<link rel="icon" type="image/svg+xml" href="../assets/favicon.svg">
<link rel="icon" type="image/png" href="../assets/favicon.png">
<link rel="stylesheet" href="{{ asset('../assets/css/app.css') }}">
<script src="{{ asset('../assets/js/theme.js') }}"></script>
</head>
<body>
<div class="admin-shell">
  <aside class="admin-sidebar">
    <a class="brand" href="../index.php" title="Перейти в чат">{% include "brand_mark.j2" %}<span>Корпоративный AI-чат<small>Панель управления</small></span></a>
    <nav class="admin-nav">
{% for group_label, sections in section_groups.items() %}
      <p class="admin-nav-group">{{ group_label }}</p>
{% for key, label in sections.items() %}
      <a href="index.php?section={{ key }}" class="{{ 'active' if active_section == key else '' }}"{% if active_section == key %} aria-current="page"{% endif %}>{{ label }}</a>
{% endfor %}
{% endfor %}
    </nav>
    <div class="admin-sidebar-foot">{% include "theme_toggle.j2" %}</div>
  </aside>
  <main class="admin-main">
    <div class="admin-topbar">
      <h1>{{ page_title }}</h1>
      <div class="settings-search" id="settingsSearch">
        <svg class="settings-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" id="settingsSearchInput" class="text-input" placeholder="Поиск настройки… (код или название)" autocomplete="off" aria-label="Поиск настройки">
        <div class="settings-search-results" id="settingsSearchResults" hidden></div>
      </div>
      <div class="user-info">
        <span class="user-info-label">Сеанс администратора</span>
        <strong>{{ admin_username or '' }}</strong>
        <a href="index.php?action=logout">Выйти</a>
      </div>
    </div>
    <script type="application/json" id="settingsSearchIndex">{{ settings_index_json }}</script>
{% if flash_success %}
    <div class="alert alert-success" role="status">{{ flash_success }}</div>
{% endif %}
{% if flash_error %}
    <div class="alert alert-error" role="alert">{{ flash_error }}</div>
{% endif %}
{{ body }}
  </main>
</div>
<script src="{{ asset('../assets/js/app.js') }}"></script>
</body>
</html>
